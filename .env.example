# Environment configuration
# Copy this file to .env.local and fill in the required values.

# Gemini API key for embeddings and chat generation (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Vector database selector: "lancedb" (default local embedded) or "supabase" (remote pgvector)
VECTOR_DB=lancedb

# LanceDB storage path (defaults to ./data/lancedb)
LANCEDB_URI=./data/lancedb

# Optional Supabase configuration (only used when VECTOR_DB=supabase)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
